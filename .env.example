# Безопасность панели управления диспетчера (Basic Auth)
QUEUE_USERNAME=admin
QUEUE_PASSWORD=change_me

# Базовые настройки безопасности Flask и вебхуков
SECRET_KEY=change_me
WEBHOOK_SECRET=change_me
DB_NAME=uk_calls.db

# Авторизационный токен МТС Exolve
EXOLVE_API_KEY=your_api_key_here

# Номер МТС Exolve, привязанный к вашему приложению (без знака "+")
EXOLVE_NUMBER=78005553535

# ID заранее созданного Callback-ресурса (целое число).
# Перед запуском в реальном режиме создайте Callback-ресурс
# в личном кабинете Exolve или через API метод callback/v1/Create.
EXOLVE_CALLBACK_RESOURCE_ID=123456

# Ресурс голосового приветствия для жильца (опционально)
EXOLVE_CLIENT_AUDIO_RESOURCE_ID=

# Локальная эмуляция телефонии без реальных списаний (true/false)
EXOLVE_MOCK=true
EXOLVE_TIMEOUT=10

# Рабочие телефоны УК
EMERGENCY_SERVICE_PHONE=79991112233
DEFAULT_OPERATOR_PHONE=79991114455
